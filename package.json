{
	"name": "enstorlaskreview",
	"version": "0.0.1",
	"scripts": {
		"dev": "vite dev",
		"build": "pnpm validate:content && vite build && node scripts/postbuild.mjs",
		"preview": "node scripts/serve-static.mjs",
		"test": "pnpm test:unit --run && pnpm test:integration",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test:integration": "playwright test",
		"test:unit": "vitest",
		"validate:content": "node scripts/validate-content.ts",
		"test:build": "node scripts/build-test-site.mjs"
	},
	"devDependencies": {
		"@eslint/js": "9.39.2",
		"@fontsource/archivo": "5.3.0",
		"@fontsource/ibm-plex-sans": "5.3.0",
		"@lucide/svelte": "1.25.0",
		"@playwright/test": "1.61.0",
		"@sveltejs/adapter-static": "3.0.10",
		"@sveltejs/kit": "2.70.2",
		"@sveltejs/vite-plugin-svelte": "7.1.2",
		"@tailwindcss/vite": "4.3.1",
		"@types/markdown-it": "14.1.2",
		"@types/node": "22.15.21",
		"eslint": "9.39.2",
		"eslint-config-prettier": "9.1.0",
		"eslint-plugin-svelte": "2.46.1",
		"globals": "15.15.0",
		"prettier": "3.5.3",
		"prettier-plugin-svelte": "3.3.3",
		"svelte": "5.55.7",
		"svelte-check": "4.1.5",
		"tailwindcss": "4.3.1",
		"typescript": "5.8.2",
		"typescript-eslint": "8.28.0",
		"vite": "8.0.16",
		"vitest": "4.1.11",
		"yaml": "2.9.0"
	},
	"dependencies": {
		"maplibre-gl": "6.4.1",
		"markdown-it": "14.3.1"
	},
	"type": "module",
	"packageManager": "pnpm@12.8.1",
	"engines": {
		"node": ">=24.16.0 <25"
	},
	"private": true
}
